# ============================================================
# KORI ALP — Variables de Entorno Backend
# Copia este archivo como .env y llena los valores reales
# ⚠️  NUNCA subas el .env real a GitHub
# ============================================================

PORT=3000
NODE_ENV=development

# ─── Supabase (obtén estos valores en: Settings > API) ───────
# Connection string de PostgreSQL (Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres"

# URL del proyecto Supabase (Settings > API > Project URL)
SUPABASE_URL="https://[TU-PROJECT-REF].supabase.co"

# Clave pública (anon) — se puede exponer al frontend
SUPABASE_ANON_KEY="eyJ..."

# Clave privada (service_role) — SOLO en el backend, NUNCA en el frontend
SUPABASE_SERVICE_KEY="eyJ..."

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────
# URLs que pueden hacer peticiones al backend
CORS_ORIGIN=http://localhost:5173

# ─── Cómo encontrar tus valores en Supabase ─────────────────
# 1. Entra a https://supabase.com → tu proyecto
# 2. Ve a Settings (ícono engranaje, menú izquierdo)
# 3. Sección "API"  → copia Project URL, anon key, service_role key
# 4. Sección "Database" → Connection string → URI → copia y reemplaza [TU-PASSWORD]
